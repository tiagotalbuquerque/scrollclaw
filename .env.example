# ScrollClaw — environment template (refactor 2026-04)
# Copy to .env or source from your secrets store.

# ─── Required ──────────────────────────────────────────────────────────
# fal.ai — gateway único para vídeo + imagem:
#   • A-roll Sora 2 (talking head)
#   • B-roll Seedance 2.0 (scenes)
#   • First frame Nano Banana 2 (imagem)
FAL_KEY=

# Google AI Studio — Gemini 2.5 Pro para virality scoring (modelos texto rodam free tier)
GEMINI_API_KEY=

# ─── Optional ──────────────────────────────────────────────────────────
# OpenAI — alternative virality scorer (GPT-5.5). If set, can be selected via SCORE_PROVIDER=openai
OPENAI_API_KEY=

# ElevenLabs — multi-clip voice consistency (S2S). Single-clip works without it (uses Sora native voice).
ELEVENLABS_API_KEY=

# ─── Model overrides (sane defaults if unset) ──────────────────────────
# First frame model (via fal.ai):
#   fal-ai/nano-banana-2           ← default, qualidade Pro Image (Gemini 3 Pro Image hosted)
#   fal-ai/nano-banana             ← fallback, geração 1 (mais antigo)
#   fal-ai/imagen4/preview         ← Imagen 4 alternativa
FIRST_FRAME_MODEL=fal-ai/nano-banana-2

# B-roll model (fal.ai):
#   bytedance/seedance-2.0/fast/text-to-video    ← default for cost ~$0.024/s
#   bytedance/seedance-2.0/text-to-video         ← standard, better quality, ~$0.30/s
#   fal-ai/kling-video/v3/pro/text-to-video      ← legacy fallback
BROLL_MODEL=bytedance/seedance-2.0/fast/text-to-video

# A-roll talking head model (fal.ai):
#   fal-ai/sora-2/image-to-video                 ← default
#   fal-ai/sora-2-pro/image-to-video             ← higher quality
#   bytedance/seedance-2.0/image-to-video        ← Sora-deprecation fallback
AROLL_MODEL=fal-ai/sora-2/image-to-video

# Virality scoring provider:
#   gemini    ← default. Uses gemini-2.5-pro by default.
#   openai    ← uses gpt-5.5 if OPENAI_API_KEY is set
SCORE_PROVIDER=gemini
SCORE_MODEL=gemini-2.5-pro
